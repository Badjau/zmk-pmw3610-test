 #include <zephyr/dt-bindings/input/input-event-codes.h>

  &pinctrl {
      pmw_spi1_default: pmw_spi1_default {
          group1 {
              psels = <NRF_PSEL(SPIM_SCK, 0, 29)>,
                      <NRF_PSEL(SPIM_MOSI, 0, 31)>,
                      <NRF_PSEL(SPIM_MISO, 0, 31)>;
          };
      };

      pmw_spi1_sleep: pmw_spi1_sleep {
          group1 {
              psels = <NRF_PSEL(SPIM_SCK, 0, 29)>,
                      <NRF_PSEL(SPIM_MOSI, 0, 31)>,
                      <NRF_PSEL(SPIM_MISO, 0, 31)>;
              low-power-enable;
          };
      };
  };

  &spi1 {
      status = "okay";
      compatible = "nordic,nrf-spim";

      pinctrl-0 = <&pmw_spi1_default>;
      pinctrl-1 = <&pmw_spi1_sleep>;
      pinctrl-names = "default", "sleep";

      cs-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;

      trackball: trackball@0 {
          status = "okay";
          compatible = "pixart,pmw3610-alt";
          reg = <0>;
          spi-max-frequency = <2000000>;

          irq-gpios = <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

          cpi = <600>;
          evt-type = <INPUT_EV_REL>;
          x-input-code = <INPUT_REL_X>;
          y-input-code = <INPUT_REL_Y>;
      };
  };

  &gpio1 {
      pmw3610_reset_hog {
          gpio-hog;
          gpios = <13 GPIO_ACTIVE_HIGH>;
          output-high;
          line-name = "PMW3610_nRESET";
      };
  };
  
  / {
      trackball_listener {
          compatible = "zmk,input-listener";
          device = <&trackball>;
      };

      // No keys are attached, so use a zero-key scanner.
      mock_kscan: mock_kscan_0 {
          compatible = "zmk,kscan-mock";
          columns = <0>;
          rows = <0>;
          events = <0>;
      };

      chosen {
          zmk,kscan = &mock_kscan;
      };
  };